// Cloudflare Workers — aplikasi HISADA (Workers + D1).
// Deploy otomatis dari GitHub (Workers Builds) setiap push ke main.
// Rahasia diatur di dashboard Cloudflare (Settings → Variables and Secrets), BUKAN di file ini:
//   SETUP_KEY            — kunci sekali pakai untuk membuat Moderator pertama
//   GOOGLE_CLIENT_SECRET — Client Secret OAuth Google
//   GMAIL_REFRESH_TOKEN  — (opsional) refresh token akun pengirim (scope gmail.send); tanpa ini email tetap antre
// Variabel biasa GMAIL_PENGIRIM (alamat pengirim, mis. hisada@daarululuumlido.com) boleh diisi di "vars" atau dashboard.
{
  "name": "hisada",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hisada", "database_id": "8d0c1711-289c-4708-80ba-b2b169135cb3" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "710546920311-lvlipfed7s6er003bmv6qq7ebmd7qfke.apps.googleusercontent.com",
    "GOOGLE_HD": "daarululuumlido.com",
    "APP_URL": "https://hisada.216326.workers.dev"
  },
  // Tiap 5 menit: overdue + pelanggaran otomatis, akhir skorsing, kirim antrean email.
  "triggers": { "crons": ["*/5 * * * *"] },
  "keep_vars": true,
  "observability": { "enabled": true }
}
